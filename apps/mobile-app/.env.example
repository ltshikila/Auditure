# API Configuration
# For local development, use your local machine's IP address
# You can find it by running `ipconfig` (Windows) or `ifconfig` (Mac/Linux)
EXPO_PUBLIC_API_URL=http://localhost:3000

# Expo Project ID (required for push notifications)
EXPO_PUBLIC_PROJECT_ID=your-expo-project-id

# RevenueCat public SDK keys (one per platform, get from RevenueCat dashboard > Project Settings > API Keys)
# Use the test key prefixed with test_ during integration; swap to live goog_* / appl_* keys for production.
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
