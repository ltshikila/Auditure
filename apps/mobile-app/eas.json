{
  "cli": {
    "version": ">= 15.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY": "test_EodoGHreMloKVUhBAEfogqTNZrf",
        "EXPO_PUBLIC_REVENUECAT_IOS_API_KEY": "test_EodoGHreMloKVUhBAEfogqTNZrf"
      },
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.auditure.app",
        "EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY": "test_EodoGHreMloKVUhBAEfogqTNZrf",
        "EXPO_PUBLIC_REVENUECAT_IOS_API_KEY": "test_EodoGHreMloKVUhBAEfogqTNZrf"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.auditure.app"
      }
    }
  },
  "submit": {
    "alpha": {
      "android": {
        "serviceAccountKeyPath": "./google-services-key.json",
        "track": "alpha"
      }
    },
    "beta": {
      "android": {
        "serviceAccountKeyPath": "./google-services-key.json",
        "track": "beta"
      }
    },
    "production": {
      "android": {
        "serviceAccountKeyPath": "./google-services-key.json",
        "track": "production"
      }
    }
  }
}
