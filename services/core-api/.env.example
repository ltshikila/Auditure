# PostgreSQL connection
DATABASE_URL="postgresql://admin:password@localhost:5432/auditure_db?schema=public"

# JWT Configuration (REQUIRED - app will not start without these)
JWT_SECRET="your-jwt-secret-here"
JWT_EXPIRES_IN="30m"
JWT_REFRESH_SECRET="your-refresh-secret-here"
JWT_REFRESH_EXPIRES_IN="30d"

# Email Configuration (Resend API)
EMAIL_FROM="Auditure <support@auditure.app>"
RESEND_API_KEY="re_your_resend_api_key_here"

# OTP Configuration
OTP_EXPIRY_MINUTES="10"

# Storage Configuration
STORAGE_BACKEND="local"
LOCAL_STORAGE_PATH="./storage"
# GCS_BUCKET_NAME="your-gcs-bucket" # Required when STORAGE_BACKEND=gcs

# File Upload Limits
MAX_FILE_SIZE_MB="50"

# RabbitMQ Configuration
RABBITMQ_URL="amqp://user:password@localhost:5672"

# Redis Configuration
REDIS_HOST="localhost"
REDIS_PORT="6379"

# Text Extraction
EXTRACTION_RETRY_ATTEMPTS="3"
EXTRACTION_TIMEOUT_MS="600000"

# Paystack Configuration
PAYSTACK_SECRET_KEY="sk_test_your_key_here"
PAYSTACK_PUBLIC_KEY="pk_test_your_key_here"
PAYSTACK_PLAN_CODE_STARTER="PLN_your_starter_plan"
PAYSTACK_PLAN_CODE_PRO="PLN_your_pro_plan"
APP_URL="http://localhost:3000"
MOBILE_APP_SCHEME="auditure"

# CORS (comma-separated origins for production)
# CORS_ORIGINS="https://your-domain.com,capacitor://localhost"

# Sentry (optional - error monitoring)
# SENTRY_DSN="https://your-sentry-dsn-here@sentry.io/project-id"

# Node environment
# NODE_ENV="production"
