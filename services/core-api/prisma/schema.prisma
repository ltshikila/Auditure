// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String       @id @default(uuid())
  email            String       @unique
  password         String
  firstName        String
  lastName         String
  dateOfBirth      DateTime?
  isEmailVerified  Boolean      @default(false)
  otpCode          String?
  otpExpiry        DateTime?
  refreshToken     String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  // Relations
  books            Book[]
  podcasters       Podcaster[]
  episodes         Episode[]
  settings         UserSettings?
  subscription     Subscription?
  podcasterRatings PodcasterRating[]
  episodeComments  EpisodeComment[]
  notifications    Notification[]

  @@map("users")
}

model Book {
  id                String       @id @default(uuid())
  userId            String

  // Metadata
  title             String
  author            String?
  isbn              String?
  language          String       @default("en")
  pageCount         Int?

  // Source Information
  sourceType        SourceType
  originalFileName  String?

  // Storage
  fileStorageKey    String
  fileSize          Int?
  fileMimeType      String?

  // Cover Image
  coverImageUrl     String?      // Public URL for cover image (from Google Books or S3)
  coverImageKey     String?      // S3 storage key (for extracted covers)

  // Extraction Status
  extractionStatus  ExtractionStatus @default(PENDING)
  extractionError   String?
  extractionWarnings String[]        // Warnings about extraction quality (e.g., "Could not detect chapters")
  extractedAt       DateTime?

  // Content
  fullTextKey       String?

  // Timestamps
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  // Relations
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapters          Chapter[]
  episodes          Episode[]

  @@index([userId])
  @@index([extractionStatus])
  @@index([title])                          // Search index
  @@index([author])                         // Search index
  @@index([userId, extractionStatus])       // Composite for user's completed books search
  @@map("books")
}

model Chapter {
  id              String    @id @default(uuid())
  bookId          String

  // Chapter Info
  chapterNumber   Int
  title           String?

  // Content Location
  startPage       Int?
  endPage         Int?
  textLength      Int?

  // Extracted Text
  extractedText   String?   @db.Text

  // Timestamps
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  book            Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([bookId, chapterNumber])
  @@index([bookId])
  @@map("chapters")
}

model Podcaster {
  id                      String    @id @default(uuid())
  userId                  String

  // Core Identity
  name                    String
  description             String?
  profilePictureUrl       String?

  // Voice Configuration
  voiceModel              VoiceModel
  gender                  Gender
  accent                  String
  speakingSpeed           Int       @default(5)    // 1-10
  vocalPitch              Int       @default(5)    // 1-10
  ageTone                 Int       @default(5)    // 1-10
  sentenceStructure       Int       @default(5)    // 1-10, Concise to Elaborate
  emotionalExpression     Int       @default(5)    // 1-10, Monotone to Expressive

  // Computed TTS Voice (set on create/update, used by ai-worker)
  geminiVoiceName         String?                  // Gemini voice name (e.g., "Zephyr", "Aoede")

  // Core Personality Model
  tone                    Int       @default(5)    // 1-10, Calm to Energetic
  communicationStyle      Int       @default(5)    // 1-10, Storytelling to Analytical
  humorLevel              Int       @default(5)    // 1-10, Dry to Comedic
  conversationalDepth     Int       @default(5)    // 1-10, Surface-Level to Deep Thinking
  chaosFactor             Int       @default(5)    // 1-10, Steady to Volatile

  // Knowledge & Worldview
  expertiseTags           String[]                 // Philosophy, Psychology, Finance, etc.
  intellectualAngle       String                   // Skeptical, Open-minded, Critical, etc.
  viewpointBehavior       Int       @default(5)    // 1-10, Agreeable to Challenging

  // Metadata
  isPublic                Boolean   @default(false)
  playCount               Int       @default(0)
  likeCount               Int       @default(0)
  shareCount              Int       @default(0)

  // Rating
  averageRating           Float     @default(0)
  ratingCount             Int       @default(0)

  // Timestamps
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  // Relations
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  episodes                Episode[]
  ratings                 PodcasterRating[]

  @@index([userId])
  @@index([isPublic])
  @@index([playCount])
  @@index([averageRating])
  @@index([name])                           // Search index
  @@index([isPublic, playCount])            // Composite for public podcasters sorted by popularity
  @@map("podcasters")
}

model PodcasterRating {
  id          String    @id @default(uuid())
  podcasterId String
  userId      String
  rating      Int       // 1-5 stars

  // Timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  podcaster   Podcaster @relation(fields: [podcasterId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([podcasterId, userId]) // One rating per user per podcaster
  @@index([podcasterId])
  @@index([userId])
  @@map("podcaster_ratings")
}

enum VoiceModel {
  CUSTOM
  CONVERSATIONAL
  ENERGETIC
  CALM
  SARCASTIC
  ACADEMIC
}

enum Gender {
  MALE
  FEMALE
}

enum SourceType {
  PDF
  EPUB
  URL
}

enum ExtractionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  PARTIALLY_COMPLETED
}

// Episode Generation Status
enum EpisodeStatus {
  PENDING
  SCRIPT_GENERATING
  SCRIPT_GENERATED
  AUDIO_GENERATING
  COMPLETED
  FAILED
}

// Episode Type (number of speakers)
enum EpisodeType {
  MONOLOGUE
  DUO
  GROUP
}

// Episode Theme (content approach)
enum EpisodeTheme {
  LECTURE
  DISCUSSION
  DEBATE
}

// Content Coverage (how much of the book)
enum ContentCoverage {
  ENTIRE_BOOK
  MULTIPLE_CHAPTERS
  SINGLE_CHAPTER
}

// Voice Tier for TTS (affects quality and cost)
enum VoiceTier {
  STANDARD  // Google Cloud Standard voices - $4/1M chars
  GEMINI    // Gemini 2.5 Pro TTS - ~$0.32/10-min episode
}

// Subscription tier
enum SubscriptionTier {
  FREE
  STARTER
  PRO
}

// Theme preference for app settings
enum ThemePreference {
  LIGHT
  DARK
  SYSTEM
}

model Episode {
  id                    String         @id @default(uuid())
  userId                String
  podcasterId           String
  bookId                String

  // Core Content
  title                 String
  description           String?
  summary               String?        @db.Text  // AI-generated episode synopsis

  // Content Configuration
  contentCoverage       ContentCoverage
  chapters              Int[]          // Chapter numbers to cover
  episodeType           EpisodeType
  episodeTheme          EpisodeTheme
  targetLengthMin       Int            // Minimum target length in minutes
  targetLengthMax       Int            // Maximum target length in minutes
  voiceTier             VoiceTier      @default(STANDARD)  // TTS voice quality tier

  // Generated Content
  scriptContent         String?        @db.Text
  audioFileKey          String?        // Storage key for audio file

  // Generation Status
  generationStatus      EpisodeStatus  @default(PENDING)
  scriptGeneratedAt     DateTime?
  audioGeneratedAt      DateTime?
  generationError       String?

  // Audio Properties
  duration              Int?           // Actual duration in seconds
  audioFormat           String?        // mp3, wav, etc

  // Metadata
  isPublic              Boolean        @default(false)
  playCount             Int            @default(0)
  likeCount             Int            @default(0)
  shareCount            Int            @default(0)

  // Timestamps
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  // Relations
  user                  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  podcaster             Podcaster      @relation(fields: [podcasterId], references: [id], onDelete: Cascade)
  book                  Book           @relation(fields: [bookId], references: [id], onDelete: Cascade)
  comments              EpisodeComment[]

  @@index([userId])
  @@index([podcasterId])
  @@index([bookId])
  @@index([isPublic])
  @@index([generationStatus])
  @@index([title])                                    // Search index
  @@index([isPublic, generationStatus, playCount])    // Composite for public completed episodes sorted by popularity
  @@index([userId, generationStatus])                 // Composite for user's episodes by status
  @@map("episodes")
}

model EpisodeComment {
  id          String    @id @default(uuid())
  episodeId   String
  userId      String
  content     String    @db.Text

  // Timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  episode     Episode   @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([episodeId])
  @@index([userId])
  @@index([createdAt])
  @@map("episode_comments")
}

model UserSettings {
  id                        String          @id @default(uuid())
  userId                    String          @unique

  // Theme
  theme                     ThemePreference @default(SYSTEM)

  // Notifications
  pushNotificationsEnabled  Boolean         @default(true)
  emailNotificationsEnabled Boolean         @default(true)
  marketingEmailsEnabled    Boolean         @default(false)
  expoPushToken             String?         // Expo Push Notification token

  // Privacy
  profilePublic             Boolean         @default(false)
  showListeningActivity     Boolean         @default(true)

  // Audio/Playback
  autoPlayEnabled           Boolean         @default(true)
  playbackSpeed             Float           @default(1.0)
  downloadOverWifiOnly      Boolean         @default(true)

  // Legal
  termsAcceptedAt           DateTime?
  termsVersion              String?
  privacyPolicyAcceptedAt   DateTime?
  privacyPolicyVersion      String?

  // Timestamps
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt

  // Relations
  user                      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model Subscription {
  id                        String           @id @default(uuid())
  userId                    String           @unique

  // Subscription Info
  tier                      SubscriptionTier @default(FREE)

  // Usage Tracking (reset monthly)
  geminiEpisodesUsed        Int              @default(0)
  standardEpisodesUsed      Int              @default(0)
  usagePeriodStart          DateTime         @default(now())

  // Limits (configurable per tier)
  geminiEpisodeLimit        Int              @default(1)
  standardEpisodeLimit      Int              @default(2)

  // Paystack integration
  paystackCustomerCode      String?          // Paystack customer code (CUS_xxx)
  paystackSubscriptionCode  String?          // Paystack subscription code (SUB_xxx)
  paystackEmailToken        String?          // Token for subscription management
  premiumStartedAt          DateTime?
  premiumExpiresAt          DateTime?

  // Timestamps
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt

  // Relations
  user                      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tier])
  @@index([usagePeriodStart])
  @@index([paystackCustomerCode])
  @@map("subscriptions")
}

model TermsAndConditions {
  id            String   @id @default(uuid())

  version       String   @unique
  content       String   @db.Text
  effectiveDate DateTime
  isActive      Boolean  @default(false)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("terms_and_conditions")
}

// Notification type enum
enum NotificationType {
  EPISODE_READY
  EPISODE_FAILED
  NEW_COMMENT
  NEW_RATING
  SUBSCRIPTION_WARNING
  SYSTEM
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  data      Json?            // Payload for deep linking (episodeId, bookId, route, etc.)
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  // Relations
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt(sort: Desc)])
  @@map("notifications")
}
