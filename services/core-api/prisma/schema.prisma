// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String       @id @default(uuid())
  email            String       @unique
  password         String
  firstName        String
  lastName         String
  dateOfBirth      DateTime?
  isEmailVerified  Boolean      @default(false)
  otpCode          String?
  otpExpiry        DateTime?
  refreshToken     String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  // Relations
  books            Book[]
  podcasters       Podcaster[]
  episodes         Episode[]

  @@map("users")
}

model Book {
  id                String       @id @default(uuid())
  userId            String

  // Metadata
  title             String
  author            String?
  isbn              String?
  language          String       @default("en")
  pageCount         Int?

  // Source Information
  sourceType        SourceType
  originalFileName  String?

  // Storage
  fileStorageKey    String
  fileSize          Int?
  fileMimeType      String?

  // Extraction Status
  extractionStatus  ExtractionStatus @default(PENDING)
  extractionError   String?
  extractedAt       DateTime?

  // Content
  fullTextKey       String?

  // Timestamps
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  // Relations
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapters          Chapter[]
  episodes          Episode[]

  @@index([userId])
  @@index([extractionStatus])
  @@map("books")
}

model Chapter {
  id              String    @id @default(uuid())
  bookId          String

  // Chapter Info
  chapterNumber   Int
  title           String?

  // Content Location
  startPage       Int?
  endPage         Int?
  textLength      Int?

  // Extracted Text
  extractedText   String?   @db.Text

  // Timestamps
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  book            Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([bookId, chapterNumber])
  @@index([bookId])
  @@map("chapters")
}

model Podcaster {
  id                      String    @id @default(uuid())
  userId                  String

  // Core Identity
  name                    String
  description             String?
  profilePictureUrl       String?

  // Voice Configuration
  voiceModel              VoiceModel
  gender                  Gender
  accent                  String
  speakingSpeed           Int       @default(5)    // 1-10
  vocalPitch              Int       @default(5)    // 1-10
  ageTone                 Int       @default(5)    // 1-10
  sentenceStructure       Int       @default(5)    // 1-10, Concise to Elaborate
  emotionalExpression     Int       @default(5)    // 1-10, Monotone to Expressive

  // Core Personality Model
  tone                    Int       @default(5)    // 1-10, Calm to Energetic
  communicationStyle      Int       @default(5)    // 1-10, Storytelling to Analytical
  humorLevel              Int       @default(5)    // 1-10, Dry to Comedic
  conversationalDepth     Int       @default(5)    // 1-10, Surface-Level to Deep Thinking
  chaosFactor             Int       @default(5)    // 1-10, Steady to Volatile

  // Knowledge & Worldview
  expertiseTags           String[]                 // Philosophy, Psychology, Finance, etc.
  intellectualAngle       String                   // Skeptical, Open-minded, Critical, etc.
  viewpointBehavior       Int       @default(5)    // 1-10, Agreeable to Challenging

  // Metadata
  isPublic                Boolean   @default(false)
  playCount               Int       @default(0)
  likeCount               Int       @default(0)
  shareCount              Int       @default(0)

  // Timestamps
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  // Relations
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  episodes                Episode[]

  @@index([userId])
  @@index([isPublic])
  @@index([playCount])
  @@map("podcasters")
}

enum VoiceModel {
  CUSTOM
  CONVERSATIONAL
  ENERGETIC
  CALM
  SARCASTIC
  ACADEMIC
}

enum Gender {
  MALE
  FEMALE
}

enum SourceType {
  PDF
  EPUB
  URL
}

enum ExtractionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  PARTIALLY_COMPLETED
}

// Episode Generation Status
enum EpisodeStatus {
  PENDING
  SCRIPT_GENERATING
  SCRIPT_GENERATED
  AUDIO_GENERATING
  COMPLETED
  FAILED
}

// Episode Type (number of speakers)
enum EpisodeType {
  MONOLOGUE
  DUO
  GROUP
}

// Episode Theme (content approach)
enum EpisodeTheme {
  LECTURE
  DISCUSSION
  DEBATE
}

// Content Coverage (how much of the book)
enum ContentCoverage {
  ENTIRE_BOOK
  MULTIPLE_CHAPTERS
  SINGLE_CHAPTER
}

// Voice Tier for TTS (affects quality and cost)
enum VoiceTier {
  STANDARD  // Google Cloud Standard voices - $4/1M chars
  NEURAL    // Google Cloud Neural2 voices - $16/1M chars
}

model Episode {
  id                    String         @id @default(uuid())
  userId                String
  podcasterId           String
  bookId                String

  // Core Content
  title                 String
  description           String?

  // Content Configuration
  contentCoverage       ContentCoverage
  chapters              Int[]          // Chapter numbers to cover
  episodeType           EpisodeType
  episodeTheme          EpisodeTheme
  targetLengthMin       Int            // Minimum target length in minutes
  targetLengthMax       Int            // Maximum target length in minutes
  voiceTier             VoiceTier      @default(NEURAL)  // TTS voice quality tier

  // Generated Content
  scriptContent         String?        @db.Text
  audioFileKey          String?        // Storage key for audio file

  // Generation Status
  generationStatus      EpisodeStatus  @default(PENDING)
  scriptGeneratedAt     DateTime?
  audioGeneratedAt      DateTime?
  generationError       String?

  // Audio Properties
  duration              Int?           // Actual duration in seconds
  audioFormat           String?        // mp3, wav, etc

  // Metadata
  isPublic              Boolean        @default(false)
  playCount             Int            @default(0)
  likeCount             Int            @default(0)
  shareCount            Int            @default(0)

  // Timestamps
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  // Relations
  user                  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  podcaster             Podcaster      @relation(fields: [podcasterId], references: [id], onDelete: Cascade)
  book                  Book           @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([podcasterId])
  @@index([bookId])
  @@index([isPublic])
  @@index([generationStatus])
  @@map("episodes")
}
