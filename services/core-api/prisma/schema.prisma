// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String       @id @default(uuid())
  email            String       @unique
  password         String
  firstName        String
  lastName         String
  dateOfBirth      DateTime?
  isEmailVerified  Boolean      @default(false)
  otpCode          String?
  otpExpiry        DateTime?
  refreshToken     String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  // Relations
  books            Book[]
  podcasters       Podcaster[]

  @@map("users")
}

model Book {
  id                String       @id @default(uuid())
  userId            String

  // Metadata
  title             String
  author            String?
  isbn              String?
  language          String       @default("en")
  pageCount         Int?

  // Source Information
  sourceType        SourceType
  originalFileName  String?

  // Storage
  fileStorageKey    String
  fileSize          Int?
  fileMimeType      String?

  // Extraction Status
  extractionStatus  ExtractionStatus @default(PENDING)
  extractionError   String?
  extractedAt       DateTime?

  // Content
  fullTextKey       String?

  // Timestamps
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  // Relations
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapters          Chapter[]

  @@index([userId])
  @@index([extractionStatus])
  @@map("books")
}

model Chapter {
  id              String    @id @default(uuid())
  bookId          String

  // Chapter Info
  chapterNumber   Int
  title           String?

  // Content Location
  startPage       Int?
  endPage         Int?
  textLength      Int?

  // Extracted Text
  extractedText   String?   @db.Text

  // Timestamps
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  book            Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([bookId, chapterNumber])
  @@index([bookId])
  @@map("chapters")
}

model Podcaster {
  id                      String    @id @default(uuid())
  userId                  String

  // Core Identity
  name                    String
  description             String?
  profilePictureUrl       String?

  // Voice Configuration
  voiceModel              VoiceModel
  gender                  Gender
  accent                  String
  speakingSpeed           Int       @default(5)    // 1-10
  vocalPitch              Int       @default(5)    // 1-10
  ageTone                 Int       @default(5)    // 1-10
  sentenceStructure       Int       @default(5)    // 1-10, Concise to Elaborate
  emotionalExpression     Int       @default(5)    // 1-10, Monotone to Expressive

  // Core Personality Model
  tone                    Int       @default(5)    // 1-10, Calm to Energetic
  communicationStyle      Int       @default(5)    // 1-10, Storytelling to Analytical
  humorLevel              Int       @default(5)    // 1-10, Dry to Comedic
  conversationalDepth     Int       @default(5)    // 1-10, Surface-Level to Deep Thinking
  chaosFactor             Int       @default(5)    // 1-10, Steady to Volatile

  // Knowledge & Worldview
  expertiseTags           String[]                 // Philosophy, Psychology, Finance, etc.
  intellectualAngle       String                   // Skeptical, Open-minded, Critical, etc.
  viewpointBehavior       Int       @default(5)    // 1-10, Agreeable to Challenging

  // Metadata
  isPublic                Boolean   @default(false)
  playCount               Int       @default(0)
  likeCount               Int       @default(0)
  shareCount              Int       @default(0)

  // Timestamps
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  // Relations
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isPublic])
  @@index([playCount])
  @@map("podcasters")
}

enum VoiceModel {
  CUSTOM
  CONVERSATIONAL
  ENERGETIC
  CALM
  SARCASTIC
  ACADEMIC
}

enum Gender {
  MALE
  FEMALE
}

enum SourceType {
  PDF
  EPUB
  URL
}

enum ExtractionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  PARTIALLY_COMPLETED
}
