{
    "name": "core-api",
    "version": "0.0.1",
    "description": "",
    "author": "",
    "private": true,
    "license": "UNLICENSED",
    "scripts": {
        "build": "nest build",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/main",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
        "test:e2e": "jest --config ./test/jest-e2e.json",
        "db:start": "docker-compose up -d",
        "db:stop": "docker-compose stop",
        "db:restart": "docker-compose restart",
        "db:logs": "docker-compose logs -f postgres",
        "db:seed": "npx ts-node prisma/seed.ts",
        "db:push": "npx prisma db push",
        "db:studio": "npx prisma studio",
        "db:reset": "docker-compose down -v && docker-compose up -d && timeout 5 && npx prisma db push && npx ts-node prisma/seed.ts"
    },
    "dependencies": {
        "@google-cloud/run": "^3.2.0",
        "@google-cloud/storage": "^7.19.0",
        "@gxl/epub-parser": "^2.0.4",
        "@nestjs/common": "^11.0.1",
        "@nestjs/core": "^11.0.1",
        "@nestjs/jwt": "^11.0.2",
        "@nestjs/mapped-types": "*",
        "@nestjs/passport": "^11.0.5",
        "@nestjs/platform-express": "^11.1.10",
        "@prisma/adapter-pg": "^7.2.0",
        "@prisma/client": "^7.2.0",
        "@sentry/nestjs": "^10.38.0",
        "amqplib": "^0.10.9",
        "bcrypt": "^6.0.0",
        "canvas": "3.2.1",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.3",
        "dotenv": "^17.2.3",
        "he": "^1.2.0",
        "helmet": "^8.1.0",
        "ioredis": "^5.8.2",
        "multer": "^2.0.2",
        "nodemailer": "^7.0.12",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1",
        "pdf-parse": "^1.1.1",
        "pdfjs-dist": "^5.4.296",
        "pg": "^8.16.3",
        "reflect-metadata": "^0.2.2",
        "resend": "^6.6.0",
        "rxjs": "^7.8.1",
        "tesseract.js": "^7.0.0"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.2.0",
        "@eslint/js": "^9.18.0",
        "@nestjs/cli": "^11.0.0",
        "@nestjs/schematics": "^11.0.0",
        "@nestjs/testing": "^11.0.1",
        "@prisma/studio-server": "^0.511.0",
        "@types/bcrypt": "^6.0.0",
        "@types/express": "^5.0.0",
        "@types/he": "^1.2.3",
        "@types/ioredis": "^4.28.10",
        "@types/jest": "^30.0.0",
        "@types/multer": "^2.0.0",
        "@types/node": "^22.10.7",
        "@types/nodemailer": "^7.0.4",
        "@types/passport-jwt": "^4.0.1",
        "@types/pg": "^8.16.0",
        "@types/supertest": "^6.0.3",
        "eslint": "^9.18.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-plugin-prettier": "^5.2.2",
        "globals": "^16.0.0",
        "jest": "^30.0.0",
        "prettier": "^3.4.2",
        "prisma": "^7.2.0",
        "source-map-support": "^0.5.21",
        "supertest": "^7.1.4",
        "ts-jest": "^29.2.5",
        "ts-loader": "^9.5.2",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.7.3",
        "typescript-eslint": "^8.20.0"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": ".",
        "roots": [
            "<rootDir>/src",
            "<rootDir>/test"
        ],
        "testRegex": ".*\\.spec\\.ts$",
        "testPathIgnorePatterns": [
            "\\.e2e-spec\\.ts$"
        ],
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "collectCoverageFrom": [
            "src/**/*.(t|j)s"
        ],
        "coverageDirectory": "./coverage",
        "testEnvironment": "node",
        "setupFiles": [
            "<rootDir>/test/setup.ts"
        ]
    },
    "prisma": {
        "seed": "ts-node prisma/seed.ts"
    }
}
