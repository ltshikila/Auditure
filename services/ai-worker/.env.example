# RabbitMQ
RABBITMQ_URL=amqp://localhost:5672
EPISODE_GENERATION_QUEUE=episode_generation
EPISODE_GENERATION_DLQ=episode_generation_dlq

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/bookcast

# LLM (optional - falls back to templates if not set)
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
HUGGINGFACE_MODEL=mistralai/Mistral-7B-Instruct-v0.2

# Storage
LOCAL_STORAGE_PATH=./storage

# Processing
WORDS_PER_MINUTE=150
MAX_BOOK_CONTENT_CHARS=8000
SCRIPT_GENERATION_TIMEOUT=60

# TTS
TTS_TEMP_DIR=./temp/tts

# Logging
LOG_LEVEL=INFO
